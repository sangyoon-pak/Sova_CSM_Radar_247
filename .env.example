# LLM — OpenRouter (get key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default chat model for all roles unless overridden below.
LLM_MODEL=openai/gpt-4o
# Optional: per-role OpenRouter model ids (see docs/LLM_MODELS.md)
# LLM_MODEL_MAIN=openai/gpt-4o
# LLM_MODEL_SEARCH_JSON=openai/gpt-4o-mini
# LLM_MODEL_SEARCH_RERANK=openai/gpt-4o-mini
# LLM_MODEL_MEMORY=openai/gpt-4o-mini

# Embeddings / RAG (OpenRouter)
RAG_EMBEDDING_PROVIDER=openrouter
RAG_EMBEDDING_MODEL=openai/text-embedding-3-large

# RC (scope/category) aware ranking (optional; generic across industries)
# - When enabled AND RC_SCOPE_LABELS is set, the retrieval pipeline can
#   down-rank snippets whose primary documentation scope differs from the
#   inferred scope.
# - RC_SCOPE_FIELD: YAML frontmatter field name to read from each KB markdown.
# - RC_SCOPE_LABELS: comma-separated labels to infer from the user query.
RC_SCOPE_ENABLE=false
RC_SCOPE_FIELD=product
RC_SCOPE_LABELS=
RC_SCOPE_PENALTY=100
RC_SCOPE_FILENAME_REGEX=

# LangSmith tracing (https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your-key
LANGSMITH_PROJECT=email_draft_agent

# Gmail (gog CLI) — local-only inside email_draft_agent/
GOG_HOME=./scripts/.local
GOG_ACCOUNT=your.email@example.com
GOG_KEYRING_BACKEND=file
GOG_KEYRING_PASSWORD=openclaw-gmail

# Server
HOST=127.0.0.1
PORT=8000
